# Server
PORT=3001
NODE_ENV=development

# Comma-separated browser origins.
# Render production should include the active Azure Static Web App origin.
CORS_ORIGINS=http://localhost:5173,https://lemon-grass-046e94503.7.azurestaticapps.net

# Microsoft Entra ID — API app registration
AZURE_TENANT_ID=your-tenant-id
# Application (client) ID of the HR API app registration
AZURE_API_CLIENT_ID=your-api-client-id

# Render PostgreSQL / Azure PostgreSQL password auth
DATABASE_AUTH=password
DATABASE_URL=postgresql://user:password@host:5432/your-database-name?sslmode=require

# Optional Azure PostgreSQL Entra ID auth for local/Azure-hosted environments
# DATABASE_AUTH=entra
# DATABASE_HOST=your-server.postgres.database.azure.com
# DATABASE_PORT=5432
# DATABASE_NAME=your-database-name
# DATABASE_USER=your-db-user@yourdomain.com
